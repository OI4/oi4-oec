# Separate git repositories (not part of this local repo, ADR-0012)
/legacy/
/oi4-oec-documentation/
/oi4-oec-demo/
/oi4-oec-registry/

# IDE
/.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Build output / dependencies
target/
node_modules/
# ESP-IDF example (C-096): fetched components, sdkconfig of a build in place
oec/sdk/micro/examples/esp-idf/managed_components/
oec/sdk/micro/examples/esp-idf/sdkconfig
oec/sdk/micro/examples/esp-idf/sdkconfig.old
oec/sdk/micro/examples/esp-idf/build/
# smart sensor demos on ESP-IDF: the same
oec/demos-smart-sensors/*/managed_components/
oec/demos-smart-sensors/*/sdkconfig
oec/demos-smart-sensors/*/sdkconfig.old
dist/
# the built Registry Web UI is committed and embedded (ADR-0029 §9)
!/oec/registry/ui/dist/
build/
.docusaurus/
*.log

# Secrets / dev PKI never committed (G-4.5)
*.key
*.p12
.env
