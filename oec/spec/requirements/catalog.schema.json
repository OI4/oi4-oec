{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oi4:oec:v2:spec:catalog",
  "title": "OEC v2 requirements catalog – one area file",
  "description": "Format of oec/spec/requirements/<area>.yaml (ADR-0018). Keywords follow MG 1.2 (GUARDRAILS G-1.6).",
  "type": "object",
  "additionalProperties": false,
  "required": ["area", "baseline", "requirements"],
  "properties": {
    "area": { "$ref": "#/$defs/areaCode" },
    "baseline": { "$ref": "#/$defs/commit" },
    "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
  },
  "$defs": {
    "areaCode": { "type": "string", "pattern": "^[A-Z]+(-[A-Z]+)?$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "reqId": { "type": "string", "pattern": "^REQ-[A-Z]+(-[A-Z]+)?-[0-9]{3}$" },
    "section": {
      "description": "Guideline section: document (MG = Messaging Guideline, RIG = Runtime & Infrastructure Guideline) and section number.",
      "type": "string",
      "pattern": "^(MG|RIG) ([0-9]+(\\.[0-9]+)*|[A-Z][0-9]+(\\.[0-9]+)*)$"
    },
    "ref": {
      "description": "Guideline section, guideline ADR, spec finding or project ADR.",
      "type": "string",
      "pattern": "^((MG|RIG) ([0-9]+(\\.[0-9]+)*|[A-Z][0-9]+(\\.[0-9]+)*)|GL-ADR-0[0-9]{2}|SF-[0-9]{3}|ADR-[0-9]{4})$"
    },
    "obligation": { "enum": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT", "MAY", "none"] },
    "inventoryKey": { "type": "string", "pattern": "^(MG|RIG)-[A-Za-z0-9.-]+-[0-9a-f]{8}$" },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "statement", "keyword", "domain", "applies_to", "refs", "verification", "status"],
      "properties": {
        "id": { "$ref": "#/$defs/reqId" },
        "title": { "type": "string", "minLength": 3, "maxLength": 100 },
        "statement": { "type": "string", "minLength": 10, "description": "One atomic, testable requirement in our words." },
        "keyword": {
          "description": "Obligation as stated in the guideline (MG 1.2); for graded domains it equals the Level 3 obligation.",
          "enum": ["MUST", "MUST NOT", "SHOULD", "SHOULD NOT", "MAY"]
        },
        "implicit": {
          "description": "true if the guideline states the behavior without keyword and it is treated as MUST by the interim rule of SF-035 (G-1.6).",
          "type": "boolean"
        },
        "domain": { "enum": ["messaging", "service-container", "platform"] },
        "levels": {
          "description": "Obligation per compliance level; 'none' = not required at this level (MG 1.2). Absent for domain platform (not graded, MG 1.3).",
          "type": "object",
          "additionalProperties": false,
          "required": ["L1", "L2", "L3"],
          "properties": {
            "L1": { "$ref": "#/$defs/obligation" },
            "L2": { "$ref": "#/$defs/obligation" },
            "L3": { "$ref": "#/$defs/obligation" }
          }
        },
        "applies_to": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["component", "application", "device", "publisher", "subscriber", "requester", "responder",
                     "container-image", "manufacturer", "platform", "broker", "registry"]
          }
        },
        "condition": { "type": "string", "minLength": 3 },
        "scope": {
          "description": "For umbrella requirements (e.g. level table rows): the guideline sections whose detailed requirements this entry grades.",
          "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/section" }
        },
        "refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/ref" } },
        "quotes": {
          "description": "Verbatim guideline text (Markdown formatting removed); checked against the guideline by 'spectool lint -guideline'.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ref", "text"],
            "properties": {
              "ref": { "$ref": "#/$defs/section" },
              "text": { "type": "string", "minLength": 5 }
            }
          }
        },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["schema", "d7-validate", "d7-monitor", "d7-test", "d8", "manual"] }
        },
        "inventory": {
          "description": "Keys of the inventory items (coverage/inventory.yaml) this requirement covers.",
          "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/inventoryKey" }
        },
        "status": { "enum": ["draft", "reviewed", "deprecated"] },
        "replaced_by": { "$ref": "#/$defs/reqId" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "domain": { "const": "platform" } } },
          "then": { "not": { "required": ["levels"] } },
          "else": { "required": ["levels"] }
        },
        {
          "if": { "properties": { "implicit": { "const": true } }, "required": ["implicit"] },
          "then": { "properties": { "refs": { "contains": { "const": "SF-035" } } } }
        },
        {
          "if": { "required": ["replaced_by"] },
          "then": { "properties": { "status": { "const": "deprecated" } } }
        }
      ]
    }
  }
}
