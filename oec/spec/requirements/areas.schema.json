{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oi4:oec:v2:spec:areas",
  "title": "OEC v2 requirements catalog – area registry",
  "description": "Format of oec/spec/requirements/areas.yaml (ADR-0018). Every guideline section belongs to exactly one area (longest prefix wins) for the coverage report.",
  "type": "object",
  "additionalProperties": false,
  "required": ["baseline", "areas"],
  "properties": {
    "baseline": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "areas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "title", "cycle", "status", "sections"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z]+(-[A-Z]+)?$" },
          "title": { "type": "string", "minLength": 3 },
          "cycle": { "type": "string", "pattern": "^C-[0-9]{3}$" },
          "status": {
            "description": "planned = no entries yet; drafted = all inventory items of its sections mapped, entries in draft; reviewed = confirmed by the PO.",
            "enum": ["planned", "drafted", "reviewed"]
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(MG|RIG) ([0-9]+(\\.[0-9]+)*|[A-Z][0-9]+(\\.[0-9]+)*|[a-z][a-z0-9-]*)$"
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
