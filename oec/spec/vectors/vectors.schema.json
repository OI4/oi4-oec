{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:oi4:oec:v2:spec:vectors",
  "title": "OEC v2 language-neutral test vectors",
  "description": "Format of oec/spec/vectors/**/*.yaml (ADR-0018, C-012 plan section 5). One file holds vectors of one kind. 'spectool lint' recomputes every expected result with the reference checks (topic grammar, Identification Link rules, payload envelope) and verifies guideline origins verbatim.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "baseline", "description", "vectors"],
  "properties": {
    "kind": { "enum": ["topic", "identification-link", "dnp-encoding", "oi4identifier", "payload", "broker-json"] },
    "baseline": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
    "description": { "type": "string", "minLength": 10 },
    "vectors": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    { "if": { "properties": { "kind": { "const": "topic" } } }, "then": { "properties": { "vectors": { "items": { "$ref": "#/$defs/topic" } } } } },
    { "if": { "properties": { "kind": { "const": "identification-link" } } }, "then": { "properties": { "vectors": { "items": { "$ref": "#/$defs/identificationLink" } } } } },
    { "if": { "properties": { "kind": { "const": "dnp-encoding" } } }, "then": { "properties": { "vectors": { "items": { "$ref": "#/$defs/dnp" } } } } },
    { "if": { "properties": { "kind": { "const": "oi4identifier" } } }, "then": { "properties": { "vectors": { "items": { "$ref": "#/$defs/oi4identifier" } } } } },
    { "if": { "properties": { "kind": { "const": "payload" } } }, "then": { "properties": { "vectors": { "items": { "$ref": "#/$defs/payload" } } } } },
    { "if": { "properties": { "kind": { "const": "broker-json" } } }, "then": { "properties": { "vectors": { "items": { "$ref": "#/$defs/brokerJson" } } } } }
  ],
  "$defs": {
    "reqIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^REQ-[A-Z]+(-[A-Z]+)*-[0-9]{3}$" } },
    "common": {
      "type": "object",
      "required": ["id", "title", "expected", "origin", "status"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "minLength": 3 },
        "expected": { "enum": ["valid", "invalid"] },
        "reqs": { "$ref": "#/$defs/reqIds", "description": "Requirements the vector demonstrates (valid vectors)." },
        "violates": { "$ref": "#/$defs/reqIds", "description": "Requirements an invalid vector violates." },
        "reason": { "type": "string", "minLength": 5 },
        "origin": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["guideline", "constructed"] },
            "ref": { "type": "string", "pattern": "^(MG|RIG) [A-Z]?[0-9]+(\\.[0-9]+)*$" },
            "original": { "type": "string", "description": "Guideline text the vector was derived from, if the vector differs from it." },
            "sf": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^SF-[0-9]{3}$" }, "description": "Findings that justify the difference." }
          },
          "if": { "properties": { "kind": { "const": "guideline" } } },
          "then": { "required": ["ref"], "dependentRequired": { "original": ["sf"] } },
          "else": { "not": { "anyOf": [ { "required": ["original"] } ] } }
        },
        "status": { "enum": ["draft", "reviewed"] },
        "notes": { "type": "string" }
      },
      "if": { "properties": { "expected": { "const": "valid" } } },
      "then": { "required": ["reqs"], "not": { "anyOf": [ { "required": ["violates"] }, { "required": ["reason"] } ] } },
      "else": { "required": ["violates", "reason"], "not": { "required": ["reqs"] } }
    },
    "topic": {
      "allOf": [ { "$ref": "#/$defs/common" } ],
      "properties": {
        "id": { "pattern": "^V-TOP-[0-9]{3}$" },
        "topic": { "type": "string" },
        "parse": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rule", "service_type", "app_id", "app_id_il", "method", "resource"],
          "properties": {
            "rule": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "service_type": { "type": "string" },
            "app_id": { "type": "string" },
            "app_id_il": { "type": "string" },
            "method": { "type": "string" },
            "resource": { "type": "string" },
            "source": { "type": "string" },
            "source_il": { "type": "string" },
            "filter": { "type": "string", "description": "Wire form of all Filter levels." },
            "filter_values": { "type": "array", "minItems": 1, "items": { "type": "string" }, "description": "Percent-decoded Filter levels." }
          },
          "dependentRequired": { "source": ["source_il"], "source_il": ["source"], "filter": ["filter_values", "source"], "filter_values": ["filter"] }
        },
        "fails": { "enum": ["grammar", "identification-link"] },
        "warnings": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["whitespace", "control-character"] } }
      },
      "required": ["topic"],
      "if": { "properties": { "expected": { "const": "valid" } } },
      "then": { "required": ["parse"], "not": { "required": ["fails"] } },
      "else": { "required": ["fails"], "not": { "anyOf": [ { "required": ["parse"] }, { "required": ["warnings"] } ] } },
      "unevaluatedProperties": false
    },
    "identificationLink": {
      "allOf": [ { "$ref": "#/$defs/common" } ],
      "properties": {
        "id": { "pattern": "^V-IL-[0-9]{3}$" },
        "il": { "type": "string" },
        "encoded": { "type": "string" },
        "violations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["empty", "too-long", "forbidden-character", "empty-authority", "uppercase-authority", "encoding"] } }
      },
      "anyOf": [ { "required": ["il"] }, { "required": ["encoded"] } ],
      "if": { "properties": { "expected": { "const": "valid" } } },
      "then": { "required": ["il", "encoded"], "not": { "required": ["violations"] } },
      "else": { "required": ["violations"] },
      "unevaluatedProperties": false
    },
    "dnp": {
      "allOf": [ { "$ref": "#/$defs/common" } ],
      "properties": {
        "id": { "pattern": "^V-DNP-[0-9]{3}$" },
        "expected": { "const": "valid" },
        "input": { "type": "string" },
        "output": { "type": "string" }
      },
      "required": ["input", "output"],
      "unevaluatedProperties": false
    },
    "oi4identifier": {
      "allOf": [ { "$ref": "#/$defs/common" } ],
      "properties": {
        "id": { "pattern": "^V-OID-[0-9]{3}$" },
        "manufacturer_uri": { "type": "string" },
        "model": { "type": "string" },
        "product_code": { "type": "string" },
        "serial_number": { "type": "string" },
        "oi4identifier": { "type": "string" },
        "violations": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["manufacturer-uri", "uppercase-authority", "too-long", "forbidden-character", "empty-authority"] } }
      },
      "required": ["manufacturer_uri", "model", "product_code", "serial_number"],
      "if": { "properties": { "expected": { "const": "valid" } } },
      "then": { "required": ["oi4identifier"], "not": { "required": ["violations"] } },
      "else": { "required": ["violations"], "not": { "required": ["oi4identifier"] } },
      "unevaluatedProperties": false
    },
    "payload": {
      "description": "A message (topic + JSON payload) of the Message Bus (MG 8). A guideline vector that differs from its example keeps the verbatim example in 'original' and lists every change in 'edits' (ADR-0018 amendments C-013 and C-023); 'origin' then carries neither 'original' nor 'sf'. An invalid vector lists in 'violates' exactly the requirements reported by the reference checks.",
      "allOf": [ { "$ref": "#/$defs/common" } ],
      "properties": {
        "id": { "pattern": "^V-PAY-[0-9]{3}$" },
        "origin": { "not": { "anyOf": [ { "required": ["original"] }, { "required": ["sf"] } ] } },
        "topic": { "type": "string", "description": "Topic the message is published on (not for a bare object)." },
        "payload": { "type": "string", "minLength": 2, "description": "The message (or the bare object, see 'object') as JSON text (RFC 8259), exactly one value, no duplicate keys." },
        "object": { "enum": ["DataSetMetaDataType"], "description": "The payload is a bare object of this type (e.g. the predefined MetaData of MG B2), not a message; it has no topic." },
        "mode": { "enum": ["strict", "tolerant"], "description": "Validation mode (MG 8, SF-052): strict (default) reports every undefined key, tolerant ignores undefined keys." },
        "role": { "enum": ["birth", "close", "will"], "description": "Declared role of the message (Q-020 (a), C-035): Birth (MG 6.3.3), Close (MG 6.3.4) or Will (MG 6.3.5) message. The reference checks add the single-message rules of the role (REQ-LIFE-003/007/009); D7 validate takes it as --role. Only for a message with a topic." },
        "original": { "type": "string", "description": "Verbatim example of the guideline the payload was derived from (only if a JSON Pointer edit exists)." },
        "edits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/edit" } }
      },
      "required": ["payload"],
      "oneOf": [ { "required": ["topic"], "not": { "required": ["object"] } }, { "required": ["object"], "not": { "anyOf": [ { "required": ["topic"] }, { "required": ["role"] } ] } } ],
      "dependentRequired": { "original": ["edits"] },
      "if": { "properties": { "origin": { "properties": { "kind": { "const": "constructed" } } } } },
      "then": { "not": { "anyOf": [ { "required": ["original"] }, { "required": ["edits"] } ] } },
      "unevaluatedProperties": false
    },
    "brokerJson": {
      "description": "Content of the file broker.json of the Message Bus storage (RIG 4.1.1, C-039). An invalid vector lists in 'violates' exactly the requirements reported by the reference checks.",
      "allOf": [ { "$ref": "#/$defs/common" } ],
      "properties": {
        "id": { "pattern": "^V-BRK-[0-9]{3}$" },
        "origin": { "not": { "anyOf": [ { "required": ["original"] }, { "required": ["sf"] } ] } },
        "content": { "type": "string", "minLength": 1, "description": "The file content as JSON text (RFC 8259), exactly one value, no duplicate keys." }
      },
      "required": ["content"],
      "unevaluatedProperties": false
    },
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "kind", "reason"],
      "properties": {
        "target": { "type": "string", "pattern": "^(topic|(/[^/]*)+)$", "description": "'topic' or a JSON Pointer (RFC 6901) into the payload ('removed': into the original)." },
        "kind": { "enum": ["removed", "completed", "instantiated", "corrected"] },
        "reason": { "type": "string", "minLength": 5 },
        "sf": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^SF-[0-9]{3}$" } }
      }
    }
  }
}
