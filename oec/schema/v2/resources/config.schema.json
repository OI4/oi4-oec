{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openindustry4.com/oec/v2/resources/config.schema.json",
  "title": "Config resource",
  "description": "Config DataSet (MG 8.3.3) and the Config DataSetMessage of Pub Config (Config…, MG 8.3.3.1) and Set Config (ConfigSet…, MG 8.3.3.2, MG 9.1.3). A Set is a partial update: only Value is mandatory. Rules of the rule layer: a Value that satisfies its Validation (REQ-RES-CONFIG-008, R-3), the Filter unique among the Config DataSetMessages of a Source (REQ-RES-CONFIG-015, R-3), WriterGroupName = topic Filter (REQ-MSG-024, R-2), DataSetWriterName = topic Source (REQ-MSG-023, R-2). Whether a Set matches the published Config (names, Mandatory, read-only properties) needs that publication (REQ-RES-CONFIG-005/011/023, d7-test/d7-monitor).",
  "$defs": {
    "Config": {
      "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): the Config DataSet has an optional Context and at least one Group; every other key is a GroupName",
      "type": "object",
      "properties": {
        "Context": {
          "$ref": "#/$defs/Context"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/Group"
      },
      "propertyNames": {
        "$comment": "REQ-RES-CONFIG-004 (MG 8.3.3.1, SF-084): a GroupName consists of a-z, A-Z, 0-9, - and _ and does not start with a digit or -",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "allOf": [
        {
          "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): a Config DataSet contains at least one Group",
          "not": {
            "propertyNames": {
              "const": "Context"
            }
          }
        }
      ]
    },
    "Context": {
      "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): the Context has the LocalizedText Name and an optional LocalizedText Description",
      "type": "object",
      "required": [
        "Name"
      ],
      "properties": {
        "Name": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Description": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        }
      },
      "unevaluatedProperties": {
        "$comment": "REQ-MSG-001 (MG 8): a sender adds no key beyond the guideline (strict); the tolerant flavor drops this closure",
        "not": {}
      }
    },
    "Group": {
      "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): a Group has the LocalizedText Name, an optional LocalizedText Description and at least one configuration object; every other key is a ConfigName",
      "type": "object",
      "properties": {
        "Name": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Description": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ConfigObject"
      },
      "propertyNames": {
        "$comment": "REQ-RES-CONFIG-004 (MG 8.3.3.1, SF-084): a ConfigName consists of a-z, A-Z, 0-9, - and _ and does not start with a digit or -",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "allOf": [
        {
          "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): a Group contains at least one configuration object",
          "not": {
            "propertyNames": {
              "enum": [
                "Name",
                "Description"
              ]
            }
          }
        }
      ],
      "required": [
        "Name"
      ]
    },
    "ConfigObject": {
      "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): fields of a configuration object in a Pub: Type, Value and Name mandatory",
      "type": "object",
      "required": [
        "Type",
        "Value",
        "Name"
      ],
      "properties": {
        "Type": {
          "$comment": "REQ-RES-CONFIG-006 (MG 8.3.3.1): Type is one of the OPC UA base types Boolean, ByteString, DateTime, Number, String",
          "enum": [
            "Boolean",
            "ByteString",
            "DateTime",
            "Number",
            "String"
          ]
        },
        "Value": {
          "$comment": "REQ-RES-CONFIG-007 (MG 8.3.3.1, SF-084): Value is a String",
          "type": "string"
        },
        "DefaultValue": {
          "$comment": "REQ-RES-CONFIG-007 (MG 8.3.3.1, SF-084): DefaultValue is a String",
          "type": "string"
        },
        "Unit": {
          "type": "string"
        },
        "Mandatory": {
          "type": "boolean"
        },
        "Sensitive": {
          "type": "boolean"
        },
        "Name": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Description": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Validation": {
          "$ref": "#/$defs/Validation"
        }
      },
      "allOf": [
        {
          "$comment": "REQ-RES-CONFIG-007 (MG 8.3.3.1, SF-084): a non-empty Value or DefaultValue is the string representation of its Type (Boolean true/false, Number in JSON number syntax, DateTime RFC 3339, ByteString Base64); the mask of an object with Sensitive = true is exempt (GL-ADR-021). Calendar validity of a DateTime is checked by the rule layer (R-4).",
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "Boolean"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|true|false)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|true|false)?$"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:true|false)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:true|false)?$"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "ByteString"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "DateTime"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))?$"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:[0-9]{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12][0-9]|3[01])T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9]))?$"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "Number"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)?$"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?)?$"
                      }
                    }
                  }
                }
              }
            }
          ]
        },
        {
          "$comment": "REQ-RES-CONFIG-024 (MG 8.3.3.1, MG 9.1.3, GL-ADR-021): in a Pub, a non-empty Value or DefaultValue of an object with Sensitive = true is the mask ********",
          "if": {
            "type": "object",
            "required": [
              "Sensitive"
            ],
            "properties": {
              "Sensitive": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "Value": {
                "if": {
                  "type": "string"
                },
                "then": {
                  "enum": [
                    "",
                    "********"
                  ]
                }
              },
              "DefaultValue": {
                "if": {
                  "type": "string"
                },
                "then": {
                  "enum": [
                    "",
                    "********"
                  ]
                }
              }
            }
          }
        }
      ],
      "unevaluatedProperties": {
        "$comment": "REQ-MSG-001 (MG 8): a sender adds no key beyond the guideline (strict); the tolerant flavor drops this closure",
        "not": {}
      }
    },
    "Validation": {
      "$comment": "REQ-RES-CONFIG-002 (MG 8.3.3.1, MG 9.1.3, SF-084): the Validation of a configuration object has the optional fields Length (UInt32), Min and Max (numbers), Pattern (String) and Values (array of Strings)",
      "type": "object",
      "properties": {
        "Length": {
          "$ref": "../opcua.schema.json#/$defs/UInt32"
        },
        "Min": {
          "type": "number"
        },
        "Max": {
          "type": "number"
        },
        "Pattern": {
          "type": "string"
        },
        "Values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "unevaluatedProperties": {
        "$comment": "REQ-MSG-001 (MG 8): a sender adds no key beyond the guideline (strict); the tolerant flavor drops this closure",
        "not": {}
      }
    },
    "ConfigDataSetMessage": {
      "$ref": "../envelope.schema.json#/$defs/DataSetMessage",
      "properties": {
        "DataSetWriterId": {
          "$comment": "REQ-MSG-020 (MG 8.2.3): application DataSetWriterIds start at 10",
          "minimum": 10
        },
        "WriterGroupName": {
          "$comment": "REQ-MSG-024 (MG 8.2.3, MG 7.7): the WriterGroupName of a Config DataSetMessage is the Filter that addresses it: its context name, one topic-encoded level",
          "pattern": "^(?:[^\\x00#%+/]|%2B|%23|%2F|%25)+$"
        },
        "MessageType": {
          "$comment": "REQ-MSG-029 (MG 8.2.3)",
          "const": "ua-keyframe"
        },
        "Payload": {
          "$ref": "#/$defs/Config"
        }
      }
    },
    "ConfigSet": {
      "$comment": "REQ-RES-CONFIG-003 (MG 8.3.3.2, MG 9.1.3, SF-084): the Config DataSet has an optional Context and at least one Group; every other key is a GroupName",
      "type": "object",
      "properties": {
        "Context": {
          "$ref": "#/$defs/ContextSet"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/GroupSet"
      },
      "propertyNames": {
        "$comment": "REQ-RES-CONFIG-004 (MG 8.3.3.2, SF-084): a GroupName consists of a-z, A-Z, 0-9, - and _ and does not start with a digit or -",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "allOf": [
        {
          "$comment": "REQ-RES-CONFIG-003 (MG 8.3.3.2, MG 9.1.3, SF-084): a Config DataSet contains at least one Group",
          "not": {
            "propertyNames": {
              "const": "Context"
            }
          }
        }
      ]
    },
    "ContextSet": {
      "$comment": "REQ-RES-CONFIG-003 (MG 8.3.3.2, MG 9.1.3, SF-084): the Context has the LocalizedText Name and an optional LocalizedText Description",
      "type": "object",
      "required": [
        "Name"
      ],
      "properties": {
        "Name": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Description": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        }
      },
      "unevaluatedProperties": {
        "$comment": "REQ-MSG-001 (MG 8): a sender adds no key beyond the guideline (strict); the tolerant flavor drops this closure",
        "not": {}
      }
    },
    "GroupSet": {
      "$comment": "REQ-RES-CONFIG-003 (MG 8.3.3.2, MG 9.1.3, SF-084): a Group has an optional LocalizedText Name and Description and at least one configuration object; every other key is a ConfigName",
      "type": "object",
      "properties": {
        "Name": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Description": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/ConfigObjectSet"
      },
      "propertyNames": {
        "$comment": "REQ-RES-CONFIG-004 (MG 8.3.3.2, SF-084): a ConfigName consists of a-z, A-Z, 0-9, - and _ and does not start with a digit or -",
        "pattern": "^[A-Za-z_][A-Za-z0-9_-]*$"
      },
      "allOf": [
        {
          "$comment": "REQ-RES-CONFIG-003 (MG 8.3.3.2, MG 9.1.3, SF-084): a Group contains at least one configuration object",
          "not": {
            "propertyNames": {
              "enum": [
                "Name",
                "Description"
              ]
            }
          }
        }
      ]
    },
    "ConfigObjectSet": {
      "$comment": "REQ-RES-CONFIG-003 (MG 8.3.3.2, MG 9.1.3, SF-084): fields of a configuration object in a Set: Value mandatory, every other field optional",
      "type": "object",
      "required": [
        "Value"
      ],
      "properties": {
        "Type": {
          "$comment": "REQ-RES-CONFIG-006 (MG 8.3.3.2): Type is one of the OPC UA base types Boolean, ByteString, DateTime, Number, String",
          "enum": [
            "Boolean",
            "ByteString",
            "DateTime",
            "Number",
            "String"
          ]
        },
        "Value": {
          "$comment": "REQ-RES-CONFIG-007 (MG 8.3.3.2, SF-084): Value is a String",
          "type": "string"
        },
        "DefaultValue": {
          "$comment": "REQ-RES-CONFIG-007 (MG 8.3.3.2, SF-084): DefaultValue is a String",
          "type": "string"
        },
        "Unit": {
          "type": "string"
        },
        "Mandatory": {
          "type": "boolean"
        },
        "Sensitive": {
          "type": "boolean"
        },
        "Name": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Description": {
          "$ref": "../opcua.schema.json#/$defs/LocalizedText"
        },
        "Validation": {
          "$ref": "#/$defs/ValidationSet"
        }
      },
      "allOf": [
        {
          "$comment": "REQ-RES-CONFIG-007 (MG 8.3.3.2, SF-084): a non-empty Value or DefaultValue is the string representation of its Type (Boolean true/false, Number in JSON number syntax, DateTime RFC 3339, ByteString Base64); the mask of an object with Sensitive = true is exempt (GL-ADR-021). Calendar validity of a DateTime is checked by the rule layer (R-4).",
          "allOf": [
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "Boolean"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|true|false)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|true|false)?$"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:true|false)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:true|false)?$"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "ByteString"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:\\*{8}|(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    }
                  }
                },
                "else": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    },
                    "DefaultValue": {
                      "if": {
                        "type": "string"
                      },
                      "then": {
                        "pattern": "^(?:(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?)?$"
                      }
                    }
                  }
                }
              }
            },
            {
              "if": {
                "type": "object",
                "required": [
                  "Type"
                ],
                "properties": {
                  "Type": {
                    "const": "DateTime"
                  }
                }
              },
              "then": {
                "if": {
                  "type": "object",
                  "required": [
                    "Sensitive"
                  ],
                  "properties": {
                    "Sensitive": {
                      "const": true
                    }
                  }
                },
                "then": {
                  "properties": {
                    "Value": {
                      "if": {
                        "type": "string"
