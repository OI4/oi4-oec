{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openindustry4.com/oec/v2/topics/get-config.schema.json",
  "title": "Get Config (topic form get-config)",
  "description": "Entry schema of the topic form get-config (topic.abnf, matrix row Get/Config, MG 9.1.3).",
  "$ref": "../envelope.schema.json#/$defs/DataNetworkMessage",
  "allOf": [
    {
      "$comment": "REQ-MSG-011 (MG 8.2.1): the DataSetClassId of a predefined resource is present",
      "required": [
        "DataSetClassId"
      ]
    }
  ],
  "properties": {
    "DataSetClassId": {
      "$comment": "REQ-MSG-010 (MG A2): DataSetClassId of Config",
      "const": "9d5983db-440d-4474-9fd7-1cd7a6c8b6c2"
    },
    "Messages": {
      "$comment": "REQ-RES-CONFIG-016 (MG 9.1.3): only the helper DataSets PaginationRequest and Locale",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "DataSetWriterId"
          ],
          "properties": {
            "DataSetWriterId": {
              "const": 1
            }
          }
        },
        "then": {
          "$ref": "../helpers.schema.json#/$defs/PaginationRequestDataSetMessage"
        },
        "else": {
          "if": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "const": 3
              }
            }
          },
          "then": {
            "$ref": "../helpers.schema.json#/$defs/LocaleDataSetMessage"
          },
          "else": {
            "if": {
              "type": "object",
              "required": [
                "DataSetWriterId"
              ],
              "properties": {
                "DataSetWriterId": {
                  "const": 2
                }
              }
            },
            "then": {
              "$comment": "REQ-PAG-008 (MG 8.3.11): a Pagination is only sent with the method Pub",
              "not": {}
            },
            "else": {
              "if": {
                "type": "object",
                "required": [
                  "DataSetWriterId"
                ],
                "properties": {
                  "DataSetWriterId": {
                    "const": 9
                  }
                }
              },
              "then": {
                "$comment": "REQ-QRY-001 (MG 8.3.13): Config has no Query",
                "not": {}
              },
              "else": {
                "$comment": "REQ-RES-CONFIG-016 (MG 9.1.3): a Get Config carries no Config DataSetMessage",
                "not": {}
              }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "REQ-PAG-008 (MG 8.3.11): at most one PaginationRequest per NetworkMessage",
          "contains": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "const": 1
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        },
        {
          "$comment": "REQ-LOC-003 (MG 8.3.12): at most one Locale per NetworkMessage",
          "contains": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "const": 3
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  }
}
