{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openindustry4.com/oec/v2/topics/pub-event.schema.json",
  "title": "Pub Event (topic form pub-event)",
  "description": "Entry schema of the topic form pub-event (topic.abnf, matrix row Pub/Event, MG 9.1.6). Events are only published (REQ-RES-EVENT-011: the topic form exists for Pub only). That every DataSetMessage belongs to Source, EventCategory and EventLevel of the topic (DataSetWriterName, WriterGroupName) is a rule of the rule layer.",
  "$ref": "../envelope.schema.json#/$defs/DataNetworkMessage",
  "allOf": [
    {
      "$comment": "REQ-MSG-011 (MG 8.2.1): the DataSetClassId of a predefined resource is present",
      "required": [
        "DataSetClassId"
      ]
    }
  ],
  "properties": {
    "DataSetClassId": {
      "$comment": "REQ-MSG-010 (MG A2): DataSetClassId of Event",
      "const": "543ae05e-b6d9-4161-a0a3-350a0fac5976"
    },
    "Messages": {
      "$comment": "Event DataSetMessages and optionally Pagination (MG 9.1.6); REQ-RES-EVENT-011 is an umbrella of these constraints (oec/spec/coverage/implications.yaml)",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "DataSetWriterId"
          ],
          "properties": {
            "DataSetWriterId": {
              "const": 2
            }
          }
        },
        "then": {
          "$ref": "../helpers.schema.json#/$defs/PaginationDataSetMessage"
        },
        "else": {
          "if": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "const": 1
              }
            }
          },
          "then": {
            "$comment": "REQ-PAG-008 (MG 8.3.11): a PaginationRequest is only sent with the method Get",
            "not": {}
          },
          "else": {
            "if": {
              "type": "object",
              "required": [
                "DataSetWriterId"
              ],
              "properties": {
                "DataSetWriterId": {
                  "const": 3
                }
              }
            },
            "then": {
              "$comment": "REQ-LOC-003 (MG 8.3.12): a Locale is only sent with the method Get",
              "not": {}
            },
            "else": {
              "if": {
                "type": "object",
                "required": [
                  "DataSetWriterId"
                ],
                "properties": {
                  "DataSetWriterId": {
                    "const": 9
                  }
                }
              },
              "then": {
                "$comment": "REQ-QRY-001 (MG 8.3.13): a Query is only sent with the method Get",
                "not": {}
              },
              "else": {
                "$ref": "../resources/event.schema.json#/$defs/EventDataSetMessage"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "REQ-PAG-008 (MG 8.3.11): at most one Pagination per NetworkMessage",
          "contains": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "const": 2
              }
            }
          },
          "minContains": 0,
          "maxContains": 1
        }
      ]
    }
  }
}
