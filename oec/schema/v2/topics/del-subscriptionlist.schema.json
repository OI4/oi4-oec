{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.openindustry4.com/oec/v2/topics/del-subscriptionlist.schema.json",
  "title": "Del SubscriptionList (topic form del-subscriptionlist)",
  "description": "Entry schema of the topic form del-subscriptionlist (topic.abnf, matrix row Del/SubscriptionList, MG 9.1.9): exactly one entry whose TopicPath identifies the subscription to delete. That it belongs to Source and Filter of the topic is a rule of the rule layer.",
  "$ref": "../envelope.schema.json#/$defs/DataNetworkMessage",
  "allOf": [
    {
      "$comment": "REQ-MSG-011 (MG 8.2.1): the DataSetClassId of a predefined resource is present",
      "required": [
        "DataSetClassId"
      ]
    }
  ],
  "properties": {
    "DataSetClassId": {
      "$comment": "REQ-MSG-010 (MG A2): DataSetClassId of SubscriptionList",
      "const": "e5d68c47-c276-4929-8ab9-4c1090cac785"
    },
    "Messages": {
      "$comment": "Exactly one SubscriptionList DataSetMessage, no helper DataSet (MG 9.1.9)",
      "items": {
        "if": {
          "type": "object",
          "required": [
            "DataSetWriterId"
          ],
          "properties": {
            "DataSetWriterId": {
              "const": 1
            }
          }
        },
        "then": {
          "allOf": [
            {
              "$comment": "REQ-PAG-008 (MG 8.3.11): a PaginationRequest is only sent with the method Get",
              "not": {}
            },
            {
              "$comment": "REQ-PAG-009 (MG 8.3.11): a Del is not paginated",
              "not": {}
            }
          ]
        },
        "else": {
          "if": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "const": 2
              }
            }
          },
          "then": {
            "allOf": [
              {
                "$comment": "REQ-PAG-008 (MG 8.3.11): a Pagination is only sent with the method Pub",
                "not": {}
              },
              {
                "$comment": "REQ-PAG-009 (MG 8.3.11): a Del is not paginated",
                "not": {}
              }
            ]
          },
          "else": {
            "if": {
              "type": "object",
              "required": [
                "DataSetWriterId"
              ],
              "properties": {
                "DataSetWriterId": {
                  "const": 3
                }
              }
            },
            "then": {
              "$comment": "REQ-LOC-003 (MG 8.3.12): a Locale is only sent with the method Get",
              "not": {}
            },
            "else": {
              "if": {
                "type": "object",
                "required": [
                  "DataSetWriterId"
                ],
                "properties": {
                  "DataSetWriterId": {
                    "const": 9
                  }
                }
              },
              "then": {
                "$comment": "REQ-QRY-001 (MG 8.3.13): a Query is only sent with the method Get",
                "not": {}
              },
              "else": {
                "$ref": "../resources/subscriptionlist.schema.json#/$defs/SubscriptionListDataSetMessage"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "$comment": "REQ-RES-SUBLIST-011 (MG 9.1.9): a Del SubscriptionList carries exactly one SubscriptionList DataSetMessage",
          "contains": {
            "type": "object",
            "required": [
              "DataSetWriterId"
            ],
            "properties": {
              "DataSetWriterId": {
                "type": "integer",
                "minimum": 10,
                "maximum": 65535
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "$comment": "REQ-BUS-010 (MG 8.2.3): a DataSetMessage in a Set or Del request carries no SequenceNumber",
          "items": {
            "properties": {
              "SequenceNumber": {
                "not": {}
              }
            }
          }
        }
      ]
    }
  }
}
